<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_titanium</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorPrimary">#ffc2410a</item>
        <item name="android:colorAccent">#fff59e0b</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="SheetAnim">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>
</resources>
